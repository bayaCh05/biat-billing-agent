' DIAGRAM 15 — Workflow : Échéancier & Pénalités
' ============================================================
@startuml Diagram15_Penalites
!theme cerulean-outline
skinparam backgroundColor #FAFAFA
title Échéancier de Paiement & Pénalités de Retard

start
:Facture reçue\nMontant TTC : 14 280 TND\nDélai : 90 jours (3 × 30j);

:Générer 3 échéances\n(AccountingAgent);

fork
  :Échéance 1 — Jour 30\n4 760 TND;
  if (Payée à temps ?) then (Oui)
    :✅ PAID;
  else (Non)
    :⚠️ LATE — Retard détecté;
    :Jour 60 : +10%\n5 236 TND;
    if (Payée maintenant ?) then (Oui)
      :✅ PAID avec pénalité;
    else (Non)
      :Jour 90 : +21%\n5 760 TND;
      :Relance comptable;
    end if
  end if
fork again
  :Échéance 2 — Jour 60\n4 760 TND;
  :Payer à temps;
  :✅ PAID;
fork again
  :Échéance 3 — Jour 90\n4 760 TND;
  :Payer à temps;
  :✅ PAID;
end fork

note right
  Formule pénalité :
  montant × (1 + 10%)^n_périodes
  Recalcul automatique
  chaque nuit (APScheduler)
end note

:Écriture comptable pénalité:
|Débit 401 (Fournisseur) |
|Débit 668 (Pénalités de retard) |
|Crédit 532 (Banque) |
stop
@enduml


' ============================================================
' DIAGRAM 16 — Workflow : Gestion des Risques
' ============================================================
@startuml Diagram16_Risques
!theme cerulean-outline
skinparam backgroundColor #FAFAFA
title Workflow Gestion des Risques — Création & Cycle de vie

|Chef de Projet|
start

split
  :Voie A — Création manuelle;
  :Saisir titre, type,\nprobabilité, impact;
  :Cliquer "Suggérer plan mitigation"\n→ Ollama génère 3 actions;
  :Sauvegarder le risque;
split again
  :Voie B — Détection IA (APScheduler 08h00);
  :Analyser feuilles de route\ndate_fin < aujourd'hui\nET statut ∉ TERMINE/ANNULE;
  if (Risque IA déjà existant ?) then (Oui)
    :Ignorer — anti-doublon;
    stop
  else (Non)
    :Calculer retard\ndays_overdue = today - date_fin;
    :1-7j → probabilité FAIBLE\n8-30j → MOYENNE\n>30j → ELEVÉE;
    :Impact = priorité du jalon\n(BASSE→MOYEN, HAUTE→CRITIQUE);
    :Calculer criticité\nf(probabilité × impact);
    :Créer risque\ncreated_by = "system:ai"\nbadge 🤖;
  end if
end split

:Risque créé — statut IDENTIFIÉ;

|Chef de Projet|
repeat
  :Consulter la liste des risques;
  switch (Décision)
  case (Surveiller)
    :statut → EN_SURVEILLANCE;
  case (Traiter)
    :statut → EN_TRAITEMENT;
    :Appliquer plan mitigation;
  case (Clore)
    :statut → MAITRISE ou CLOTURE;
  endswitch
repeat while (Risque non clôturé ?) is (Oui)

:✅ Risque CLOTURE;
stop
@enduml


