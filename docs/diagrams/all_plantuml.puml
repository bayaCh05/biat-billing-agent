' ============================================================
' DIAGRAM 3 — Architecture Agents IA
' ============================================================
@startuml Diagram03_AgentsIA
!theme cerulean-outline
skinparam backgroundColor #FAFAFA
title 6 Agents IA + RAG — Architecture Interne

package "InvoiceProcessingOrchestrator" #FFF8E8 {
  [ExtractionAgent\nPDF → OCR → LLM] as EA #FFE0A0
  [ClassificationAgent\nFuzzy → ML → RAG] as CA #FFE0A0
  [AnomalyAgent\n8 contrôles + embeddings] as AA #FFE0A0
  [AccountingAgent\nPCE + explication] as AccA #FFE0A0
