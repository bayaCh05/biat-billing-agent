' ============================================================
' DIAGRAM 7 — Diagramme de Classes
' ============================================================
@startuml Diagram07_Classes
!theme cerulean-outline
skinparam backgroundColor #FAFAFA
skinparam classBackgroundColor #EFF4FA
skinparam classBorderColor #2E86C1
title Diagramme de Classes — Modèles Principaux

enum InvoiceStatus {
  RECEIVED
  EXTRACTING
  EXTRACTED
  CLASSIFYING
  CLASSIFIED
  VALIDATING
  VALIDATED
  FLAGGED
  JOURNALING
  JOURNALED
  EXPORTED
  PAID
  ERROR
  REJECTION_FAILED
}

enum FlagType {
  TOTAL_MISMATCH
  TVA_MISMATCH
  MISSING_FIELD
  DUPLICATE
  HIGH_VALUE
  UNKNOWN_DIRECTION
  CATALOG_NO_MATCH
}

enum NiveauCriticite {
  FAIBLE
  MOYENNE
  ELEVEE
  CRITIQUE
}

class InvoiceRecord {
  +id : UUID
  +status : InvoiceStatus
  +direction : str
  +charge_type : str
  +file_hash : str
  +issuer_name : ConfidenceField[str]
  +amount_ht : ConfidenceField[float]
  +tva_rate : ConfidenceField[float]
  +amount_ttc : ConfidenceField[float]
  +accounting_compte : str
  +human_review_required : bool
  +add_flag(flag: InvoiceFlag)
  +has_errors() bool
}

class ConfidenceField {
  +value : T
  +confidence : float
}

class InvoiceFlag {
  +flag_type : FlagType
  +severity : str
  +message : str
  +resolved : bool
}

class JournalEntry {
  +id : UUID
  +reference : str
  +date_ecriture : date
  +lines : List[JournalLine]
  +is_balanced() bool
}

class JournalLine {
  +compte : str
  +libelle : str
  +debit : float
  +credit : float
}

class Asset {
  +id : UUID
  +designation : str
  +acquisition_cost_ht : float
  +useful_life_years : int
  +depreciation_method : str
  +annual_depreciation() float
}

class Risque {
  +id : UUID
  +titre : str
  +type_risque : str
  +probabilite : str
  +impact : str
  +niveau_criticite : NiveauCriticite
  +statut : str
  +created_by : str
}

class FeuilleDeRoute {
  +id : UUID
  +titre : str
  +date_debut : date
  +date_fin : date
  +statut : str
  +priorite : str
  +days_overdue() int
  +is_late() bool
}

class BudgetPlan {
  +from_yaml(path) BudgetPlan
  +get_line(catalog_id) BudgetLine
  +ytd_budget(month) float
}

class CostCatalog {
  +from_yaml(path) CostCatalog
  +match(text, flux) CostCatalogEntry
  +get(id) CostCatalogEntry
}

InvoiceRecord "1" *-- "many" InvoiceFlag
InvoiceRecord "1" o-- "many" ConfidenceField
InvoiceRecord "1" --> "0..1" JournalEntry
JournalEntry "1" *-- "many" JournalLine
InvoiceRecord "1" --> "0..1" Asset
FeuilleDeRoute "1" o-- "many" Risque
InvoiceRecord --> CostCatalog : classe avec
InvoiceRecord --> BudgetPlan : impute dans
@enduml


