!theme cerulean-outline
skinparam backgroundColor #FAFAFA
title Schéma Base de Données — 9 Tables Principales

entity "invoices" as INV #EFF4FA {
  * id : UUID <<PK>>
  --
  status : VARCHAR (RECEIVED→PAID)
  direction : VARCHAR (SUPPLIER|CLIENT)
  charge_type : VARCHAR (OPEX|CAPEX)
  file_hash : TEXT <<unique>>
  issuer_name : TEXT
  amount_ht : FLOAT
  tva_rate : FLOAT
  amount_ttc : FLOAT
  accounting_compte : TEXT
  human_review_required : BOOL
