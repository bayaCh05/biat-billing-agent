}

entity "feuilles_de_route" as ROAD #FFF8E8 {
  * id : UUID <<PK>>
  --
  titre : TEXT
  date_debut : DATE
  date_fin : DATE
  statut : VARCHAR (PLANIFIE|EN_COURS|TERMINE)
  priorite : VARCHAR (HAUTE|MOYENNE|BASSE)
