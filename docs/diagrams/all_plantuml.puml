' ============================================================
' DIAGRAM 9 — Séquence : Pipeline IA (avec risques)
' ============================================================
@startuml Diagram09_SeqPipeline
!theme cerulean-outline
skinparam backgroundColor #FAFAFA
skinparam sequenceArrowColor #2E86C1
skinparam sequenceParticipantBackgroundColor #EFF4FA
title Pipeline IA — Facture PDF → JOURNALED (avec indicateurs de risque)

actor Comptable #1A3A5C
participant Frontend #2E86C1
participant FastAPI #2E86C1
participant Orchestrator #F0A500
participant ExtractionAgent #F0A500
participant ClassificationAgent #F0A500
participant AnomalyAgent #F0A500
participant AccountingAgent #F0A500
participant Ollama #F0A500
database Database #1A3A5C

Comptable -> Frontend : Upload PDF
Frontend -> FastAPI : POST /api/invoices/upload\nBearer token + multipart
FastAPI -> FastAPI : JWT auth + MIME check\n+ rate limit
FastAPI -> Database : AuditLog(INVOICE_UPLOADED)
FastAPI -> Orchestrator : process_invoice(invoice)

== Étape 1 — Extraction ==
note over Orchestrator #FFF8E8 : ⚠️ Risque : PDF illisible
Orchestrator -> ExtractionAgent : run({invoice})
ExtractionAgent -> ExtractionAgent : Tentative PDF natif\n(PyMuPDF)
ExtractionAgent -> ExtractionAgent : Fallback OCR Tesseract
ExtractionAgent -> Ollama : prompt extraction JSON
Ollama --> ExtractionAgent : ConfidenceField[]

alt Extraction échoue totalement
  ExtractionAgent --> Orchestrator : success=False
  Orchestrator -> Database : status = EXTRACTION_FAILED
  FastAPI --> Frontend : ❌ Extraction impossible
else Extraction ok
  ExtractionAgent --> Orchestrator : AgentResult(confidence_fields)
  Orchestrator -> Database : status = EXTRACTED

  == Étape 2 — Classification ==
  note over Orchestrator #FFF8E8 : ⚠️ Risque : compte PCE incorrect si confiance < 85%
  Orchestrator -> ClassificationAgent : run({invoice})
  ClassificationAgent -> ClassificationAgent : Pass A: CostCatalog fuzzy
  alt Pass A ≥ 70
    ClassificationAgent --> Orchestrator : Pass A matched
  else Pass A < 70 → Pass B ML
    ClassificationAgent -> ClassificationAgent : TF-IDF + LogReg
    alt Pass B ≥ 0.7
      ClassificationAgent --> Orchestrator : Pass B matched
    else Pass B < 0.7 → Pass C RAG+LLM
      ClassificationAgent -> Ollama : prompt RAG classification
      Ollama --> ClassificationAgent : compte PCE + raison
      ClassificationAgent --> Orchestrator : Pass C matched
    end
  end
  Orchestrator -> Database : status = CLASSIFIED

  == Étape 3 — Validation & Anomalies ==
  note over Orchestrator #FFF8E8 : ⚠️ Risques : math/doublon/montant suspect
  Orchestrator -> AnomalyAgent : run({invoice, db})
  AnomalyAgent -> AnomalyAgent : Math: |HT+TVA-TTC| < 0.005
  AnomalyAgent -> AnomalyAgent : Doublon: hash + sémantique
  AnomalyAgent -> AnomalyAgent : Montant > 50 000 TND ?

  alt Flag ERROR détecté
    AnomalyAgent --> Orchestrator : human_review_required=True
    Orchestrator -> Database : status = FLAGGED
    Frontend --> Comptable : ⚠️ Facture à réviser
  else Aucun flag bloquant
    Orchestrator -> Database : status = VALIDATED

    == Étape 4 — Comptabilisation ==
    note over Orchestrator #FDECEA : ⚠️ CRITIQUE : débit ≠ crédit → bloquage
    Orchestrator -> AccountingAgent : run({invoice, db})
    AccountingAgent -> AccountingAgent : Générer écriture PCE
    AccountingAgent -> AccountingAgent : Vérifier équilibre\n|Σdébits - Σcrédits| < 0.005
    AccountingAgent -> Ollama : explication comptable
    Ollama --> AccountingAgent : 2 phrases PCE

    alt CAPEX → créer actif
      AccountingAgent -> Ollama : durée amortissement (1-20 ans)
      Ollama --> AccountingAgent : N ans
      AccountingAgent -> Database : save Asset
    end

    alt Écriture équilibrée
      AccountingAgent -> Database : save JournalEntry + JournalLines
      Orchestrator -> Database : status = JOURNALED
      Frontend --> Comptable : ✅ Facture traitée — écriture PCE générée
    else Écriture déséquilibrée
      Orchestrator -> Database : status = ERROR
      Frontend --> Comptable : ❌ Erreur comptable — écriture déséquilibrée
    end
  end
end
@enduml


' ============================================================
' DIAGRAM 10 — Séquence : Authentification
' ============================================================
@startuml Diagram10_SeqAuth
!theme cerulean-outline
skinparam backgroundColor #FAFAFA
title Flux d'Authentification — Login + Refresh + OTP

actor Utilisateur #1A3A5C
participant Frontend #2E86C1
participant FastAPI #2E86C1
participant "JWT Handler" as JWT #F0A500
participant "Account Lockout" as Lock #C0391B
database Database #1A3A5C

== Login ==
Utilisateur -> Frontend : Saisit email + mot de passe
Frontend -> FastAPI : POST /api/auth/login\n{email, password}
FastAPI -> Lock : check_lockout(email)

alt Compte verrouillé
  Lock --> FastAPI : locked (remaining: Xmin)
  FastAPI --> Frontend : 423 Compte verrouillé
  Frontend --> Utilisateur : ❌ Compte verrouillé jusqu'à HH:MM
else Compte disponible
  FastAPI -> Database : Chercher user par email
  FastAPI -> FastAPI : bcrypt.verify(password, hash)

  alt Mot de passe incorrect
    FastAPI -> Lock : record_failure(email)
    FastAPI -> Database : AuditLog(LOGIN_FAILURE)
    Lock --> FastAPI : attempts=N/5
    FastAPI --> Frontend : 401 Identifiants incorrects
    Frontend --> Utilisateur : ❌ Email ou mot de passe incorrect
  else Mot de passe correct
    FastAPI -> Lock : reset_failures(email)
    FastAPI -> JWT : create_access_token(8h)
    FastAPI -> JWT : create_refresh_token(7j)
    JWT --> FastAPI : access_token, refresh_token
    FastAPI -> Database : AuditLog(LOGIN_SUCCESS)
    FastAPI --> Frontend : {access_token}\n+ cookie httpOnly biat_refresh
    Frontend -> Frontend : saveToken(access_token)\nlocalStorage: role, nom
    Frontend --> Utilisateur : ✅ Connecté — redirection Dashboard
  end
end

== Refresh automatique (token expirant dans < 5 min) ==
Frontend -> Frontend : decodeExp(token) < now + 5min
Frontend -> FastAPI : POST /api/auth/refresh\ncredentials: include (cookie)
FastAPI -> JWT : verify_refresh_token(cookie)

alt Token refresh valide
  FastAPI -> JWT : create_access_token(nouveau 8h)
  FastAPI --> Frontend : {access_token}
  Frontend -> Frontend : saveToken(nouveau_token)
else Token expiré / révoqué
  FastAPI --> Frontend : 401
  Frontend -> Frontend : clearToken()
  Frontend --> Utilisateur : Redirection /login
end

== Changement mot de passe avec OTP ==
Utilisateur -> Frontend : Demande changement mot de passe
Frontend -> FastAPI : POST /api/auth/change-password/request-otp
FastAPI -> FastAPI : Générer OTP 6 chiffres (10 min)
FastAPI -> Database : Stocker OTP hashé
FastAPI --> Frontend : {message: "OTP envoyé"}
Frontend --> Utilisateur : Saisir le code reçu
Utilisateur -> Frontend : Saisit OTP + nouveau mot de passe
Frontend -> FastAPI : POST /api/auth/change-password/confirm\n{otp_code, new_password}
FastAPI -> Database : Vérifier OTP + expiry
FastAPI -> FastAPI : bcrypt.hash(new_password)
FastAPI -> Database : Mettre à jour hash + invalider OTP
FastAPI -> Database : AuditLog(PASSWORD_CHANGED)
FastAPI --> Frontend : 200 OK
Frontend --> Utilisateur : ✅ Mot de passe mis à jour
@enduml


