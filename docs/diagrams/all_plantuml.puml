}

entity "invoice_flags" as FLAGS #FDECEA {
  * id : UUID <<PK>>
  --
  invoice_id : UUID <<FK>>
  flag_type : VARCHAR
  severity : VARCHAR (ERROR|WARNING)
  message : TEXT
  resolved : BOOL
}

entity "journal_entries" as JE #EFF4FA {
  * id : UUID <<PK>>
  --
  reference : TEXT (OD-2026-NNNN)
  date_ecriture : DATE
  source_invoice_id : UUID <<FK>>
  accounting_explanation : TEXT
}

entity "journal_lines" as JL #EFF4FA {
  * id : UUID <<PK>>
  --
  entry_id : UUID <<FK>>
  compte : TEXT (401|4366|6xxx|2xxx)
  libelle : TEXT
  debit : FLOAT
  credit : FLOAT
}

entity "assets" as ASSET #E8F5F0 {
  * id : UUID <<PK>>
  --
  designation : TEXT
  compte_immobilisation : TEXT (2xxx)
  acquisition_cost_ht : FLOAT
  useful_life_years : INT
  depreciation_method : VARCHAR
