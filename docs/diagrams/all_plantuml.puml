' ============================================================
' DIAGRAM 1 — Architecture Technique (Composants)
' ============================================================
@startuml Diagram01_ArchitectureTechnique
!theme cerulean-outline
skinparam backgroundColor #FAFAFA
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EFF4FA
  BorderColor #1A3A5C
  FontColor #1A3A5C
}
skinparam package {
  BackgroundColor #F5F7FA
  BorderColor #2E86C1
  FontColor #1A3A5C
}
skinparam arrow {
  Color #2E86C1
  FontColor #5D6D7E
  FontSize 10
}
title Architecture Technique — BIAT IT Billing Agent

package "Frontend (port 5173)" {
  [React 18 + TypeScript] as React
  [Vite + Tailwind CSS] as Vite
  [React Router v6] as Router
  [Recharts] as Charts
}

package "Backend (port 8000)" {
  [FastAPI Python 3.14] as FastAPI
  [SQLAlchemy ORM] as ORM
  [Alembic Migrations] as Alembic
  [APScheduler] as Scheduler
  [SlowAPI Rate Limiter] as RateLimit
  [JWT + bcrypt] as Auth
}

package "Couche IA (LOCAL uniquement)" #FFFCE8 {
  [InvoiceProcessingOrchestrator] as Orchestrator
  [ExtractionAgent] as ExtAgent
  [ClassificationAgent] as ClassAgent
  [AnomalyAgent] as AnomalyAgent
  [AccountingAgent] as AccAgent
  [RiskAgent] as RiskAgent
  [InsightAgent] as InsightAgent
  [Ollama qwen2.5:3b] as Ollama #FFE0A0
  [TF-IDF + LogisticRegression] as ML
  [ChromaDB (vecteurs)] as Chroma
  [PyMuPDF + Tesseract OCR] as OCR
}

package "Données" {
  database "SQLite WAL\ndata/invoices.db" as DB
  [cost_catalog.yaml\n33 entrées PCE] as Catalog
  [budget_plan.yaml] as Budget
  [ml_model.joblib] as MLModel
}

React --> FastAPI : HTTP/JSON REST\nport 8000
FastAPI --> ORM
FastAPI --> Auth
FastAPI --> RateLimit
FastAPI --> Orchestrator : process_invoice()
ORM --> DB
Alembic --> DB
Scheduler --> Orchestrator : tâches nightly
Orchestrator --> ExtAgent
Orchestrator --> ClassAgent
Orchestrator --> AnomalyAgent
Orchestrator --> AccAgent
Orchestrator --> RiskAgent
Orchestrator --> InsightAgent
ExtAgent --> OCR
ExtAgent --> Ollama
ClassAgent --> ML
ClassAgent --> Ollama
ClassAgent --> Catalog
