# Copy this file to .env and fill in real values. Never commit .env.
# DATA RESIDENCY: LOCAL ONLY — no cloud LLM keys permitted (see CLAUDE.md)

# ── LLM backend (Ollama — local only) ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434   # default Ollama endpoint

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (development)
DATABASE_URL=sqlite:///./data/invoices.db
# PostgreSQL (production) — uncomment and fill in
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/invoice_agent

# ── Ingestion ──────────────────────────────────────────────────────────────────
INBOX_FOLDER=./inbox              # folder watcher watches this path
PROCESSED_FOLDER=./processed      # files moved here after ingestion

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FILE=./logs/agent.log         # leave empty to log to stdout only

# ── CORS (comma-separated list of allowed frontend origins) ───────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# ── Rate limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true           # set to false to disable in local dev / tests

# ── Agent behaviour ────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=10
EXTRACTION_WORKERS=2              # concurrent extraction threads
MAX_RETRY_ATTEMPTS=3

# ── BCT export compliance (Banque Centrale de Tunisie — Circulaire 2025-13) ───
BCT_REPATRIATION_DAYS=120         # délai légal de rapatriement (jours)
BCT_WARNING_THRESHOLD_DAYS=20     # alerte quand il reste moins de N jours
BCT_EXPORT_PATH=./exports/bct/    # dossier de stockage des rapports BCT
BCT_DOMICILIATION_BANK=BIAT       # banque domiciliataire par défaut
