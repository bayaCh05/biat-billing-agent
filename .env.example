# Copy this file to .env and fill in real values. Never commit .env.
# DATA RESIDENCY: LOCAL ONLY — no cloud LLM keys permitted (see CLAUDE.md)

# ── LLM backend (Ollama — local only) ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434   # default Ollama endpoint

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars   # REQUIRED: min 32 chars
JWT_ACCESS_TOKEN_EXPIRE_HOURS=8
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
AUDIT_HMAC_SECRET=change-me-in-production-min-32-chars  # REQUIRED: min 32 chars

# Account lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
MAX_ACTIVE_SESSIONS=5           # sessions simultanées max par utilisateur (les plus anciennes sont révoquées)

# File uploads
MAX_FILE_SIZE_MB=20
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,tiff,tif

# Cookies (set to true in production with HTTPS)
COOKIE_SECURE=false

# ── Database — SQLite (existant) ──────────────────────────────────────────────
# SQLite (development)
DATABASE_URL=sqlite:///./data/invoices.db
# PostgreSQL (production) — uncomment and fill in
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/invoice_agent

# ── MongoDB (migration Phase 1+) ──────────────────────────────────────────────
# Si absent ou vide : l'application reste en mode SQLite uniquement (pas de crash).
# docker-compose.yml lance mongod avec --auth : ces identifiants sont requis pour
# le conteneur local, pas seulement pour un déploiement cloud.
MONGO_ROOT_USER=biat_admin
MONGO_ROOT_PASSWORD=change-me-generate-a-real-secret
# Standalone (développement local, avec authentification) :
# MONGODB_URI=mongodb://biat_admin:change-me-generate-a-real-secret@localhost:27017/?authSource=admin
# Replica set local (requis pour les transactions multi-documents) :
# MONGODB_URI=mongodb://user:password@localhost:27017,localhost:27018,localhost:27019/?replicaSet=rs0&authSource=admin
# Atlas (cloud — NE PAS utiliser avec des données de facturation réelles, voir CLAUDE.md) :
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DB=biat_billing

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FILE=./logs/agent.log         # leave empty to log to stdout only

# ── CORS (comma-separated list of allowed frontend origins) ───────────────────
# Not needed for the combined Docker Compose deployment (app serves the SPA
# and the API from the same origin, no CORS involved). Only matters if the
# frontend is ever hosted separately from the API — replace these localhost
# dev values with the real production origin(s) in that case.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# ── Rate limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true           # set to false to disable in local dev / tests

# ── Email (OTP + password reset links) ────────────────────────────────────────
# Development: run `docker compose --profile dev up -d mailhog` then open
# http://localhost:8025 — mailhog's web UI has NO authentication and shows
# every OTP/reset-link email sent through it, so it's gated behind the "dev"
# profile and never starts on a plain `docker compose up -d`. In a real
# deployment, point these vars at a real mail relay instead.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@biat-it.local
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_ENABLED=true                # set to false to skip sending (logs to stdout)
FRONTEND_URL=http://localhost:5173

# ── Sécurité avancée ──────────────────────────────────────────────────────────
# ENABLE_HSTS=false               # mettre true uniquement derrière TLS (production)
# TRUSTED_PROXY_IPS=              # IPs de reverse-proxy de confiance pour X-Forwarded-For
                                  # ex: 10.0.0.1,10.0.0.2

# ── LLM Ollama — paramètres fins ──────────────────────────────────────────────
OLLAMA_MODEL=qwen2.5:3b            # modèle à utiliser (ne pas changer sans revalider les prompts)
OLLAMA_TIMEOUT_SECONDS=30          # timeout par requête (secondes)
OLLAMA_MAX_CONCURRENT=3            # nombre de requêtes Ollama simultanées

# ── Base de données vectorielle (RAG PCE) ─────────────────────────────────────
CHROMADB_PATH=./data/chromadb      # répertoire ChromaDB local
PCE_VECTORSTORE_AUTO_INDEX=false   # true = indexer le catalogue PCE au démarrage (charge le modèle embeddings)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2  # multilingue fr/ar (même API que all-MiniLM-L6-v2)
EMBEDDER_CACHE_SIZE=1000            # entrées max dans le cache LRU d'embeddings
RAG_MIN_SIMILARITY=0.45             # seuil minimum de similarité cosinus pour les candidats RAG

# ── Comportement agent IA ─────────────────────────────────────────────────────
PAYMENT_INSTALLMENT_PERIOD_DAYS=30 # période des échéanciers générés (jours)
LATE_PAYMENT_PENALTY_RATE=0.10     # taux de pénalité de retard (0.10 = 10 %)
AI_RISK_SCAN_ENABLED=true          # activer le scan IA des risques (job hebdomadaire)
ML_RETRAIN_MIN_INVOICES=50         # seuil min de factures VALIDATED/EXPORTED pour le réentraînement ML (dimanche 3h)
AUDIT_REJECTION_RATE_WARNING_PCT=15.0            # seuil d'alerte AuditAgent : taux de rejet factures (%)
AUDIT_BUDGET_VARIANCE_WARNING_PCT=10.0           # seuil d'alerte AuditAgent : écart budgétaire (%)
AUDIT_JOURNAL_CONSISTENCY_SCORE_CRITICAL=0.99    # seuil critique AuditAgent : score de cohérence du journal

# ── Email — mode dégradé ───────────────────────────────────────────────────────
EMAIL_FALLBACK_TO_FILE=true        # si true, les emails sont écrits dans EMAIL_OUTBOX_DIR
EMAIL_OUTBOX_DIR=data/email_outbox # répertoire des emails en mode dégradé

# ── Authentification (local par défaut — LDAP optionnel) ──────────────────────
AUTH_MODE=local                    # local | ldap | hybrid (hybrid: LDAP pour @LDAP_USER_DOMAIN, local sinon)
# Si AUTH_MODE=ldap, décommenter et remplir les variables suivantes :
# LDAP_URL=ldap://localhost:389
# LDAP_BASE_DN=dc=biat,dc=local
# LDAP_USERS_OU=ou=users,dc=biat,dc=local
# LDAP_GROUPS_OU=ou=groups,dc=biat,dc=local
# LDAP_BIND_DN=cn=admin,dc=biat,dc=local
# REQUIRED si AUTH_MODE=ldap
# LDAP_BIND_PASSWORD=
# LDAP_SEARCH_ATTR=mail
# LDAP_TIMEOUT=5
# rôle par défaut si absent de l'annuaire
# LDAP_DEFAULT_ROLE=
# LDAP_USER_DOMAIN=biat.local                  # suffixe domaine Windows (UPN)
