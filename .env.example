# Copy this file to .env and fill in real values. Never commit .env.
# DATA RESIDENCY: LOCAL ONLY — no cloud LLM keys permitted (see CLAUDE.md)

# ── LLM backend (Ollama — local only) ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434   # default Ollama endpoint

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars   # REQUIRED: min 32 chars
JWT_ACCESS_TOKEN_EXPIRE_HOURS=8
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
AUDIT_HMAC_SECRET=change-me-in-production-min-32-chars  # REQUIRED: min 32 chars

# Account lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# File uploads
MAX_FILE_SIZE_MB=20
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,tiff

# Cookies (set to true in production with HTTPS)
COOKIE_SECURE=false

# Demo users (all REQUIRED unless DISABLE_DEMO_USERS=true)
DEMO_ADMIN_PASSWORD=
DEMO_COMPTABLE_PASSWORD=
DEMO_CHEF_PASSWORD=
DEMO_DIRECTION_PASSWORD=
DISABLE_DEMO_USERS=false

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (development)
DATABASE_URL=sqlite:///./data/invoices.db
# PostgreSQL (production) — uncomment and fill in
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/invoice_agent

# ── Ingestion ──────────────────────────────────────────────────────────────────
INBOX_FOLDER=./inbox              # folder watcher watches this path
PROCESSED_FOLDER=./processed      # files moved here after ingestion

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FILE=./logs/agent.log         # leave empty to log to stdout only

# ── CORS (comma-separated list of allowed frontend origins) ───────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# ── Rate limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true           # set to false to disable in local dev / tests

# ── Email (OTP + password reset links) ────────────────────────────────────────
# Development: run `docker-compose up -d` then open http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@biat-it.local
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_ENABLED=true                # set to false to skip sending (logs to stdout)
FRONTEND_URL=http://localhost:5173

# ── Agent behaviour ────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=10
EXTRACTION_WORKERS=2              # concurrent extraction threads
MAX_RETRY_ATTEMPTS=3

# ── BCT export compliance (Banque Centrale de Tunisie — Circulaire 2025-13) ───
BCT_REPATRIATION_DAYS=120         # délai légal de rapatriement (jours)
BCT_WARNING_THRESHOLD_DAYS=20     # alerte quand il reste moins de N jours
BCT_EXPORT_PATH=./exports/bct/    # dossier de stockage des rapports BCT
BCT_DOMICILIATION_BANK=BIAT       # banque domiciliataire par défaut
